<div class="hero-image-card">
  <img
    src="/images/agrirain-hero-landscape.webp"
    alt="Realistic green countryside with rain and sunlight"
    class="hero-landscape"
  />

  <div class="hero-badge">
    <span class="status-dot"></span>
    GROW WITH LOCAL INSIGHT
  </div>
</div>
.hero-image-card {
  position: relative;
  width: 100%;
  max-width: 690px;
  height: 490px;
  overflow: hidden;
  border-radius: 36px;
  border: 1px solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
}

.hero-landscape {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.hero-badge {
  position: absolute;
  bottom: 22px;
  right: 22px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 20px;
  border-radius: 40px;
  color: white;
  background: rgba(12, 45, 35, 0.88);
  border: 1px solid rgba(255, 255, 255, 0.2);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
}

.status-dot {
  width: 12px;
  height: 12px;
  background: #55ed65;
  border-radius: 50%;
  box-shadow: 0 0 12px #55ed65;
}

@media (max-width: 768px) {
  .hero-image-card {
    height: 320px;
    border-radius: 24px;
  }

  .hero-badge {
    bottom: 14px;
    right: 14px;
    font-size: 10px;
    padding: 10px 14px;
  }
}